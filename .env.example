GEMINI_API_KEY=

# Supabase (optional) — used to persist reviews server-side
# Create a project at: https://app.supabase.com
# Your project URL looks like: https://<project-ref>.supabase.co
SUPABASE_URL=
# Service role key (server-only). Get from Project Settings → API → Service Key
# Docs: https://supabase.com/docs/guides/auth#service-role
SUPABASE_SERVICE_KEY=

# For local development you can run the serverless functions with `vercel dev`,
# which reads this file automatically. Do NOT commit your real keys.
